{
  "$schema": "https://json.schemastore.org/claude-code-plugin-manifest.json",
  "name": "test-checker",
  "displayName": "Test Checker",
  "version": "0.2.0",
  "description": "Audit and verify unit tests: blind spec-first test generation, dual-version execution (buggy vs fixed), and replacement of tests that enshrine bugs. Language-agnostic.",
  "author": {
    "name": "Nakul Upadhya"
  },
  "homepage": "https://github.com/upadhyan/test-checker",
  "repository": "https://github.com/upadhyan/test-checker",
  "license": "MIT",
  "keywords": [
    "testing",
    "unit-tests",
    "verification",
    "test-generation",
    "mutation"
  ],
  "hooks": "./hooks/claude-codex-hooks.json",
  "mcpServers": {
    "tcheck": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/dist/tcheck.mjs",
        "mcp"
      ]
    }
  }
}
